    {
      "id": "XFK2tu7uZozYGltxfl3-G",
      "type": "text",
      "x": 1972.0327796921317,
      "y": 3526.032342220821,
      "width": 992.3193359375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3e",
      "roundness": null,
      "seed": 1795543114,
      "version": 437,
      "versionNonce": 1551196630,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784875901139,
      "link": null,
      "locked": false,
      "text": "Upload large files : 50gb -> there are restrictions and hops which might allow only 5-10 MBs of Data \n                              -> We'll just upload the metadata and request a presigned url from s3 \n                                and while updating we'll set status in db as \"started\", we'll use \n                                the presigned url and upload the file directly to s3\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Upload large files : 50gb -> there are restrictions and hops which might allow only 5-10 MBs of Data \n                              -> We'll just upload the metadata and request a presigned url from s3 \n                                and while updating we'll set status in db as \"started\", we'll use \n                                the presigned url and upload the file directly to s3\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "43SsMFKLEfV-IYlH0Y01D",
      "type": "text",
      "x": 2220.3628949636095,
      "y": 3909.4832007523537,
      "width": 404.3197326660156,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3h",
      "roundness": null,
      "seed": 1407875914,
      "version": 155,
      "versionNonce": 103915094,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784875019498,
      "link": null,
      "locked": false,
      "text": "Upload rate : 50gb @100mbps = 1hr12min\n\nThe internet connection may get dropped\n\nSoln :- \n    - Chunk files on client to 5mb chunk ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Upload rate : 50gb @100mbps = 1hr12min\n\nThe internet connection may get dropped\n\nSoln :- \n    - Chunk files on client to 5mb chunk ",
      "autoResize": true,
      "lineHeight": 1.25
    },
