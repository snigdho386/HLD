      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1547506542,
      "version": 703,
      "versionNonce": 1262063172,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784610303419,
      "link": null,
      "locked": false,
      "text": "Functional Requirements : \n    \n    - create a short url from long url\n        - optionally support custom alias\n        - optionally support an expiration time \n\n    - be redirected to the original url from the short url ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements : \n    \n    - create a short url from long url\n        - optionally support custom alias\n        - optionally support an expiration time \n\n    - be redirected to the original url from the short url ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5INw2syaCSPGomHAIaXmm",
      "type": "text",
      "x": 266.5999755859375,
      "y": -2455.7000579833984,
      "width": 597.4796142578125,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 1835129390,
      "version": 776,
      "versionNonce": 1235249148,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784610303419,
      "link": null,
      "locked": false,
      "text": "Non-functional requirements : \n    - Low latency on redirects (~200ms)\n    - Scale to support 100M DAU and 1B urls\n    - Ensure uniqueness of short code \n    - High availability, eventual consistency for url shortening \n    \n\nBOTE\n    - sclae\n    - latency\n    - storage\n\n(useless doing upfront)      \n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requirements : \n    - Low latency on redirects (~200ms)\n    - Scale to support 100M DAU and 1B urls\n    - Ensure uniqueness of short code \n    - High availability, eventual consistency for url shortening \n    \n\nBOTE\n    - sclae\n    - latency\n    - storage\n\n(useless doing upfront)      \n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
