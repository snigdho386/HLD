    {
      "id": "c4VJPWec7kJOXrzCVTzz0",
      "type": "text",
      "x": 1368.8544543807561,
      "y": 11117.669448027724,
      "width": 404.09967041015625,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b70",
      "roundness": null,
      "seed": 1995244556,
      "version": 538,
      "versionNonce": 1316163852,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785480005572,
      "link": null,
      "locked": false,
      "text": "Functional Requirements \n\n- Start group chats \n- Send/receive messages \n- send/receive media \n- Access messages after I've been offline\n\nNon-functional requirements \n\n- Delivered with low-latency ( <500ms )\n- Guarantee delivery of messages \n- Billions of users, high throughput\n- Messages not stored unnecessarily \n- Fault-tolerant \n\nCore Entities \n- User\n- Chats \n- Messages \n- Client\n\nAPI Interface \n\n\n\nCommands Sent \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements \n\n- Start group chats \n- Send/receive messages \n- send/receive media \n- Access messages after I've been offline\n\nNon-functional requirements \n\n- Delivered with low-latency ( <500ms )\n- Guarantee delivery of messages \n- Billions of users, high throughput\n- Messages not stored unnecessarily \n- Fault-tolerant \n\nCore Entities \n- User\n- Chats \n- Messages \n- Client\n\nAPI Interface \n\n\n\nCommands Sent \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
