      "updated": 1785230514089,
      "link": null,
      "locked": false,
      "text": "Functional requirements :- \n\n- create posts\n- follow users \n- view feed\n- Page through feed\n\nBonus :-\n- Like and comment \n- Privacy settings\n\n \n ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements :- \n\n- create posts\n- follow users \n- view feed\n- Page through feed\n\nBonus :-\n- Like and comment \n- Privacy settings\n\n \n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
