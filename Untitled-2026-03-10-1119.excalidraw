      "boundElements": [],
      "updated": 1784876392628,
      "link": null,
      "locked": false,
      "text": "File Metadata\n\n- FileId\n- File Name\n- Folder Id\n- Mime Type\n- size\n- Compression Algo\n- OwnerId\n- s3Link\n- Creation Timestamp\n- Update Timestamp\n- status : 'started'\n- chunks : [\n    {\n        id as fingerprint,\n        status,\n        s3Link,\n        updatedAt\n    }\n]\n- ... metadata",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "File Metadata\n\n- FileId\n- File Name\n- Folder Id\n- Mime Type\n- size\n- Compression Algo\n- OwnerId\n- s3Link\n- Creation Timestamp\n- Update Timestamp\n- status : 'started'\n- chunks : [\n    {\n        id as fingerprint,\n        status,\n        s3Link,\n        updatedAt\n    }\n]\n- ... metadata",
      "autoResize": true,
      "lineHeight": 1.25
    },
