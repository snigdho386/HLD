    {
      "id": "AwIcXS2x0NRbh7AUK-Me2",
      "type": "text",
      "x": 286.39996337890625,
      "y": -2713.7000579833984,
      "width": 550.4996337890625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1547506542,
      "version": 701,
      "versionNonce": 693081458,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784264620646,
      "link": null,
      "locked": false,
      "text": "Functional Requirements : \n    \n    - create a short url from long url\n        - optionally support custom alias\n        - optionally support an expiration time \n\n    - be redirected to the original url from the short url ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements : \n    \n    - create a short url from long url\n        - optionally support custom alias\n        - optionally support an expiration time \n\n    - be redirected to the original url from the short url ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aPjNV0N7IWRxvc2zhCX09",
      "type": "text",
      "x": 336,
      "y": 511.5,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
