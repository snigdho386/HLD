      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entities :\n    - Original url\n    - Short url\n    - User  \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UFo7PXp1SrF3LAB4qS1b-",
      "type": "text",
      "x": 240.12474431675486,
      "y": -1953.5783533448061,
      "width": 449.0997619628906,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 1197613234,
      "version": 200,
      "versionNonce": 1692292210,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784265021175,
      "link": null,
      "locked": false,
      "text": "API :\n    \n    - // shorten a url\n       POST /urls -> shortUrl\n       {\n            originalUrl,\n            alias?,\n            expirationTime?\n        }\n\n   - // redirection\n     GET {shortUrl} -> Redirect to originalUrl",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API :\n    \n    - // shorten a url\n       POST /urls -> shortUrl\n       {\n            originalUrl,\n            alias?,\n            expirationTime?\n        }\n\n   - // redirection\n     GET {shortUrl} -> Redirect to originalUrl",
      "autoResize": true,
      "lineHeight": 1.25
    },
